# Recorded cycle data — machine-specific, never committed
data/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# The live config is machine-specific and the app WRITES to it at runtime —
# the Setup page saves the ROI, the Shifts tab saves the roster. Tracking it
# would make `git pull` collide with the operator's own settings on every
# update. config.example.json is the tracked template; install.sh copies it
# to config.json on a fresh install and never overwrites an existing one.
config.json
config.local.json
config.json.tmp
tests/fixture.mp4
.playwright-mcp/
